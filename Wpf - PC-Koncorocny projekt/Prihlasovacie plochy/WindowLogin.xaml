<Window x:Class="Wpf___PC_Koncorocny_projekt.WindowLogin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Krionix Auth" Height="500" Width="800"
        WindowState="Maximized" WindowStyle="None" Background="#020205"
        KeyDown="Window_KeyDown" PreviewMouseDown="Window_PreviewMouseDown">

    <Window.Resources>
        <!-- Animácia načítavania -->
        <Storyboard x:Key="RotateLoading">
            <DoubleAnimation Storyboard.TargetName="LoadingRotateTransform" 
                             Storyboard.TargetProperty="Angle"
                             From="0" To="360" Duration="0:0:1" 
                             RepeatBehavior="Forever" />
        </Storyboard>

        <!-- Štýl pre tlačidlá v Power Menu -->
        <Style x:Key="PowerMenuStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#80FFFFFF"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#15FFFFFF"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Viewbox Stretch="Uniform">
            <Grid Width="800" Height="500">
                <!-- HLAVNÉ POZADIE -->
                <Grid x:Name="MainContentGrid">
                    <Grid.Background>
                        <RadialGradientBrush Center="0.5,0.5" RadiusX="0.7" RadiusY="0.7">
                            <GradientStop Color="#0A0A12" Offset="0"/>
                            <GradientStop Color="#020205" Offset="1"/>
                        </RadialGradientBrush>
                    </Grid.Background>

                    <!-- LOGIN KARTA -->
                    <Border x:Name="LoginBox" Width="360" VerticalAlignment="Center" 
                            Background="#0DFFFFFF" CornerRadius="25" BorderThickness="1" 
                            BorderBrush="#20FFFFFF" Padding="40">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="40" Opacity="0.8" ShadowDepth="0"/>
                        </Border.Effect>

                        <Grid>
                            <!-- HLAVNÉ OVLÁDACIE PRVKY -->
                            <StackPanel x:Name="LoginControls" Visibility="Visible">
                                <TextBlock Text="KRIONIX" FontSize="32" FontWeight="Black" 
                                           HorizontalAlignment="Center" Foreground="White" Margin="0,0,0,35"/>

                                <TextBlock Text="USERNAME" Foreground="#50FFFFFF" FontSize="9" FontWeight="Bold" Margin="0,0,0,8"/>
                                <Border CornerRadius="10" Background="#10FFFFFF" BorderThickness="1" BorderBrush="#15FFFFFF" Margin="0,0,0,20">
                                    <TextBox x:Name="UserNameTxt" Background="Transparent" Foreground="White" 
                                             BorderThickness="0" Height="42" VerticalContentAlignment="Center" Padding="15,0" CaretBrush="White"/>
                                </Border>

                                <TextBlock Text="PASSWORD" Foreground="#50FFFFFF" FontSize="9" FontWeight="Bold" Margin="0,0,0,8"/>
                                <Border CornerRadius="10" Background="#10FFFFFF" BorderThickness="1" BorderBrush="#15FFFFFF" Margin="0,0,0,30">
                                    <PasswordBox x:Name="PasswordTxt" Background="Transparent" Foreground="White" 
                                                 BorderThickness="0" Height="42" VerticalContentAlignment="Center" Padding="15,0" CaretBrush="White"/>
                                </Border>

                                <Button x:Name="UserButton" Click="UserButton_Click" Height="48" Cursor="Hand" BorderThickness="0" Margin="0,0,0,15">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="btnBorder" Background="White" CornerRadius="12">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="btnBorder" Property="Opacity" Value="0.9"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <TextBlock Text="Log in" FontWeight="Bold" Foreground="Black" FontSize="12"/>
                                </Button>

                                <Button x:Name="ChangeUserButton" Content="Create Account" Background="Transparent" 
                                        Foreground="#40FFFFFF" BorderThickness="0" FontSize="10" Cursor="Hand" Click="ChangeUserButton_Click"/>
                            </StackPanel>

                           
                            <StackPanel x:Name="LoadingOverlay" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Grid Width="50" Height="50">
                                    <Ellipse Stroke="#10FFFFFF" StrokeThickness="3"/>
                                    <Ellipse Stroke="White" StrokeThickness="3" StrokeDashArray="2 1" RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <RotateTransform x:Name="LoadingRotateTransform" Angle="0"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                </Grid>
                                <TextBlock Text="AUTORIZUJEM..." Foreground="White" Margin="0,20,0,0" HorizontalAlignment="Center" FontWeight="Light"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- TLAČIDLO NASTAVENIA -->
                    <Button x:Name="SetingButton" Click="SetingButton_Click" HorizontalAlignment="Left" VerticalAlignment="Bottom" 
                            Margin="30" Width="45" Height="45" Background="#0DFFFFFF" BorderThickness="1" BorderBrush="#15FFFFFF">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="22"/>
                            </Style>
                        </Button.Resources>
                        <TextBlock Text="⚙" Foreground="White" FontSize="18" HorizontalAlignment="Center"/>
                    </Button>

                    <!-- POWER MENU -->
                    <Border x:Name="PowerMenuOverlay" Visibility="Collapsed" Background="#F205050A" CornerRadius="15" 
                            Width="180" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="30,0,0,85" 
                            BorderBrush="#15FFFFFF" BorderThickness="1">
                        <StackPanel Margin="8">
                            <Button Content="ZAMKNÚŤ" Click="Lock_Click" Style="{StaticResource PowerMenuStyle}"/>
                            <Button Content="REŠTART" Click="Restart_Click" Style="{StaticResource PowerMenuStyle}"/>
                            <Separator Background="#10FFFFFF" Margin="10,5"/>
                            <Button Content="VYPNÚŤ" Click="Shutdown_Click" Style="{StaticResource PowerMenuStyle}" Foreground="#FF4B4B"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- REGISTRAČNÝ MODAL -->
                <Grid x:Name="NewUserModal" Visibility="Collapsed">
                    <Grid.Background>
                        <SolidColorBrush Color="Black" Opacity="0.85"/>
                    </Grid.Background>
                    <Border Width="360" Background="#15151F" CornerRadius="25" VerticalAlignment="Center" 
                            HorizontalAlignment="Center" Padding="35" BorderBrush="#20FFFFFF" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="REGISTRÁCIA" Foreground="White" FontWeight="Bold" FontSize="18" 
                                       HorizontalAlignment="Center" Margin="0,0,0,30"/>

                            <TextBlock Text="MENO" Foreground="#50FFFFFF" FontSize="9" Margin="0,0,0,5"/>
                            <Border CornerRadius="8" Background="#08FFFFFF" BorderThickness="1" BorderBrush="#15FFFFFF" Margin="0,0,0,15">
                                <TextBox x:Name="NewUserTxt" Background="Transparent" Foreground="White" BorderThickness="0" Height="38" VerticalContentAlignment="Center" Padding="12,0"/>
                            </Border>

                            <TextBlock Text="HESLO" Foreground="#50FFFFFF" FontSize="9" Margin="0,0,0,5"/>
                            <Border CornerRadius="8" Background="#08FFFFFF" BorderThickness="1" BorderBrush="#15FFFFFF" Margin="0,0,0,15">
                                <PasswordBox x:Name="NewPassTxt" Background="Transparent" Foreground="White" BorderThickness="0" Height="38" VerticalContentAlignment="Center" Padding="12,0"/>
                            </Border>

                            <TextBlock Text="POTVRDENIE" Foreground="#50FFFFFF" FontSize="9" Margin="0,0,0,5"/>
                            <Border CornerRadius="8" Background="#08FFFFFF" BorderThickness="1" BorderBrush="#15FFFFFF" Margin="0,0,0,25">
                                <PasswordBox x:Name="ConfirmPassTxt" Background="Transparent" Foreground="White" BorderThickness="0" Height="38" VerticalContentAlignment="Center" Padding="12,0"/>
                            </Border>

                            <UniformGrid Columns="2" Height="45">
                                <Button Content="ZRUŠIŤ" Click="CloseModal_Click" Background="Transparent" Foreground="#50FFFFFF" BorderThickness="0" Cursor="Hand" />
                                <Button x:Name="ConfirmRegistrationBtn" Click="ConfirmRegistrationBtn_Click" Background="White" BorderThickness="0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="White" CornerRadius="10">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <TextBlock Text="POTVRDIŤ" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Viewbox>

        <!-- REŽIM SPÁNKU -->
        <Grid x:Name="SleepOverlay" Background="Black" Visibility="Collapsed" Panel.ZIndex="9999"/>
    </Grid>
</Window>