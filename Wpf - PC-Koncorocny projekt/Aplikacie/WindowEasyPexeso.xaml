<Window x:Class="Wpf___PC_Koncorocny_projekt.WindowEasyPexeso"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Pexeso" Height="700" Width="1100"
        WindowState="Maximized" WindowStyle="None" ResizeMode="NoResize" Background="#111">

    <Grid>
        <Button Content="✖" Width="40" Height="40"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="15"
                Click="BtnClose_Click" Background="Transparent" Foreground="White"
                BorderThickness="0" FontSize="20"/>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="PEXESO 6x6" Foreground="White" FontSize="36" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,20"/>
            <TextBlock x:Name="TxtStatus" Foreground="Yellow" FontSize="20"
                       HorizontalAlignment="Center" Margin="0,0,0,10"/>
            <Border Background="#1D1D1D" Padding="10" CornerRadius="10">
                <UniformGrid x:Name="CardGrid" Columns="6" Rows="6" Width="600" Height="600"/>
            </Border>
        </StackPanel>
    </Grid>
</Window>